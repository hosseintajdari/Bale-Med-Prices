# Copy to .env.telegram in the repo root (gitignored) or export in your shell.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN
WEB_APP_URL=https://your-public-host.example.com/

# Local polling mode (default when webhook URL is empty)
API_BASE_URL=http://127.0.0.1:4000

# Production webhook mode (API serves POST /telegram/webhook)
# TELEGRAM_WEBHOOK_URL=https://your-public-host.example.com/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret

# Optional TTAC detail links in web + API moreInfo
# TTAC_DETAIL_URL_TEMPLATE=https://your-ttac-host.example.com/drug/{ttacCode}
