# Copy what's needed; NEVER commit a filled-in env file.
# Port the API listens on (host side of docker-compose).
PORT=4000
API_BASE_URL=http://127.0.0.1:4000
# Host directory holding darukade.sqlite3 (harvested public price catalog).
# Mounted read-only into the API container as /app/data/scrapers.
DARUKADE_DATA_DIR=./data/scrapers
# Local (non-docker) runs: point the API straight at the catalog file.
# DARUKADE_DB_PATH=/path/to/darukade.sqlite3
