# Copy to telegram.env (same folder) and fill in your values.
# telegram.env is gitignored — never commit the real token.
#
# 1) Talk to @BotFather on Telegram and create a bot → TELEGRAM_BOT_TOKEN
# 2) Send any message to your bot, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the numeric chat id → TELEGRAM_CHAT_ID
#
# Optional: set these in your shell profile instead of telegram.env.

TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=123456789
