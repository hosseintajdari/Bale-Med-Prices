{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/telegram-forward.sh",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/telegram-forward.sh",
        "timeout": 5
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/telegram-forward.sh",
        "timeout": 8
      }
    ]
  }
}
